# Backend API base URL (include /api prefix). Change after deployment.
NEXT_PUBLIC_API_BASE_URL=https://parcel-nest.vercel.app/api
# https://parcel-nest.vercel.app/

# Socket.IO origin for live notifications. Defaults to the API's origin.
# The API must run on a host with long-lived connections (not Vercel functions).
# NEXT_PUBLIC_SOCKET_URL=https://your-api-host.example.com
